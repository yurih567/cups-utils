# Printer destination — only the identifier.
# cups-examples (JS) reads this and passes -dest to cups-printer,
# which auto-detects the protocol (TCP / CUPS / file / stdout).
#
# Examples:
#   PRINTER=192.168.18.133          → TCP JetDirect :9100
#   PRINTER=TM20                    → CUPS queue
PRINTER=192.168.18.133

# Driver model: generic | epson | bematech
# Use bematech on Bematech printers — generic cut (GS V) prints a literal "V".
PRINTER_MODEL=bematech
